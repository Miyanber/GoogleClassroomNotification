# ==============================================================================
# Google Apps Script - スクリプト プロパティ設定テンプレート
# ==============================================================================
# Google Apps Script エディタの「プロジェクトの設定」>「スクリプト プロパティ」に
# 以下のプロパティ名と値を設定してください。
# ==============================================================================

# 【必須】ユーザー設定を保存するGoogleスプレッドシートのID
# 例: https://docs.google.com/spreadsheets/d/XXXXXXXXXX/edit の XXXXXXXXXX 部分
SPREADSHEET_ID=your_spreadsheet_id_here

# 【必須】Google Cloud Console で作成した OAuth 2.0 クライアントID
# 承認済みのリダイレクトURIには以下を指定してください:
# https://script.google.com/macros/d/{SCRIPT_ID}/usercallback
CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com

# 【必須】Google Cloud Console で作成した OAuth 2.0 クライアントシークレット
CLIENT_SECRET=your_oauth_client_secret

# 【推奨】メール通知の送信元・案内用メールアドレス
SENDER_EMAIL=notification-noreply@example.com

# 【任意】APIレスポンスのキャッシュ機能を利用するかどうか (True / False)
USE_CACHE=True

# 【任意】メール通知の受信を制限したい内部ドメイン（例: 生徒用アカウント等）
# 設定すると、このドメインを含むメールアドレスでの利用登録をブロックします。
RESTRICTED_DOMAIN=

# 【任意】お問い合わせ・配信停止受付用のGoogleフォーム等のURL
INQUIRY_FORM_URL=

# 【任意】Webアプリのファビコン画像URL
FAVICON_URL=

# 【任意】メールテンプレート内で使用するチャットアイコン等の画像URL
CHAT_ICON_URL=
